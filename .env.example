# Banco (Neon). Na Vercel, a integração do Neon escreve estas variáveis sozinha.
# NUNCA guardar estas três no próprio banco: são o que abre o banco e as sessões.
DATABASE_URL=
SESSAO_SEGREDO=
SEGREDOS_CHAVE=

# Primeiro administrador: usados uma única vez por POST /api/admin/inicializar.
# Depois de criar a conta, apague as duas da Vercel.
ADMIN_EMAIL=
ADMIN_SENHA=

# Contato mostrado quando os minutos gratuitos acabam (entra no bundle, é público).
# Só dígitos, com DDI: 5511987654321. Sem ele, o botão cai no e-mail abaixo.
VITE_SUPORTE_WHATSAPP=
VITE_SUPORTE_EMAIL=suporte@deepcar.com.br

# Acervo de esquemas (gerado por `node scripts/exportar-acervo.mjs`).
# Em desenvolvimento o Vite serve ACERVO_DIR em /acervo; em produção VITE_ACERVO_URL aponta para o bucket R2.
ACERVO_DIR=E:\deepcar-publicacao
# VITE_ACERVO_URL=https://acervo.seudominio.com.br

# Consulta de placa: Falcon Data Hub — https://datahub.falcon-server.com.br
# (plano grátis: 10 consultas/hora; Premium R$ 49,90/mês: 1.000/hora). Painel → token Bearer.
# Em produção, grave no /admin → Chaves de API (fica cifrado no banco, vale sem deploy).
# Sem token, a consulta roda em modo simulado (placas de teste: AAA0000, ABC1D23, BRA2E19, FIA1T23, HON2C24).
FALCON_TOKEN=
# opcional: só se o endereço mudar (padrão: https://beta.falcon-server.com.br/data-hub)
# FALCON_BASE_URL=

# Pagamento (Cakto). O webhook e os ids dos produtos ficam no /admin → Chaves de API
# (cifrados no banco, valem sem deploy): CAKTO_WEBHOOK_SECRET, CAKTO_PRODUTO_PRO, CAKTO_PRODUTO_FULL,
# CAKTO_PRODUTO_PRO_ANUAL, CAKTO_PRODUTO_FULL_ANUAL.
# Só os links de checkout entram no bundle, porque o navegador precisa deles:
VITE_CAKTO_CHECKOUT_PRO=
VITE_CAKTO_CHECKOUT_FULL=
# anual: compra única de 12 meses, em até 12x (link = https://pay.cakto.com.br/<id da oferta>)
VITE_CAKTO_CHECKOUT_PRO_ANUAL=
VITE_CAKTO_CHECKOUT_FULL_ANUAL=
