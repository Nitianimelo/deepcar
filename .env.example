# Acervo de esquemas (gerado por `node scripts/exportar-acervo.mjs`).
# Em desenvolvimento o Vite serve ACERVO_DIR em /acervo; em produção VITE_ACERVO_URL aponta para o bucket R2.
ACERVO_DIR=E:\deepcar-publicacao
# VITE_ACERVO_URL=https://acervo.seudominio.com.br

# Provedor de consulta de placa. O primeiro configurado é usado; sem nenhum, roda em modo simulado
# (placas de teste: AAA0000, ABC1D23, BRA2E19, FIA1T23, HON2C24).

# 1) Falcon Data Hub — https://datahub.falcon-server.com.br (plano grátis; Premium R$ 49,90/mês)
#    Dashboard → token Bearer
FALCON_TOKEN=
# opcional: só se a base mudar (padrão: https://beta.falcon-server.com.br/data-hub)
# FALCON_BASE_URL=

# 2) Consultar Placa — alternativa paga por consulta (R$ 0,31)
CONSULTARPLACA_EMAIL=
CONSULTARPLACA_API_KEY=
